# Keep secrets and local artefacts out of the image. Configuration reaches
# the container at runtime (env_file / environment), never via the image.
.env
.env.*
!.env.example

# Python and test caches
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local virtual environments
.venv/
venv/

# Editor and OS files
.vscode/
.idea/
.DS_Store
