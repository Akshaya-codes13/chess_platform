# development | test | production. "production" refuses to start with a
# weak or placeholder SECRET_KEY.
APP_ENV=development

DATABASE_URL=postgresql+psycopg2://chess:chess@db:5432/chess_academy
REDIS_URL=redis://redis:6379/0
# Production: at least 32 random characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# Connection pool per process, and a per-statement timeout (0 disables it).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=30000

# Tests use a separate database and Redis DB. By default they derive from
# DATABASE_URL (database name + "_test") and REDIS_URL (DB index 15).
# TEST_DATABASE_URL=postgresql+psycopg2://chess:chess@db:5432/chess_academy_test
# TEST_REDIS_URL=redis://redis:6379/15
CORS_ORIGINS=http://localhost:5173
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
DEMO_LOGIN_ENABLED=false

# Uploaded images. "local" stores files under MEDIA_ROOT (a Docker volume).
STORAGE_BACKEND=local
MEDIA_ROOT=/data/media
MEDIA_MAX_BYTES=5242880
